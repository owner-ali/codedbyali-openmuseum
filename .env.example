# Copy this file to .env and fill it in. Never commit .env.

# Your public site address (used for canonical links, Open Graph and share links).
# Local development: http://localhost:5173
VITE_SITE_URL=https://your-site.pages.dev

# Optional: the contact form opens the visitor's mail app addressed to this email.
# (Admins can also set this later in Admin > Site settings.)
VITE_CONTACT_EMAIL=

# Supabase (free). Supabase dashboard > Project Settings > API.
# Use the "Project URL" and the PUBLIC "anon" key only.
# NEVER put the service_role key in any VITE_ variable: everything starting with
# VITE_ is shipped to every visitor's browser.
# Leave both empty to run the site in demo mode with generated sample art.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
